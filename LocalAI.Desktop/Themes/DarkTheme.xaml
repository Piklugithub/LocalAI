<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Window -->
    <SolidColorBrush x:Key="WindowBackgroundBrush"
                     Color="#0F172A" />

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush"
                     Color="#111827" />

    <!-- Main content -->
    <SolidColorBrush x:Key="ContentBackgroundBrush"
                     Color="#0F172A" />

    <!-- Cards -->
    <SolidColorBrush x:Key="CardBackgroundBrush"
                     Color="#1E293B" />

    <!-- Primary text -->
    <SolidColorBrush x:Key="PrimaryTextBrush"
                     Color="#F8FAFC" />

    <!-- Secondary text -->
    <SolidColorBrush x:Key="SecondaryTextBrush"
                     Color="#CBD5E1" />

    <!-- Muted text -->
    <SolidColorBrush x:Key="MutedTextBrush"
                     Color="#94A3B8" />

    <!-- Border -->
    <SolidColorBrush x:Key="BorderBrush"
                     Color="#334155" />

    <!-- Input -->
    <SolidColorBrush x:Key="InputBackgroundBrush"
                     Color="#1E293B" />

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush"
                     Color="#60A5FA" />

    <!-- Accent hover -->
    <SolidColorBrush x:Key="AccentHoverBrush"
                     Color="#3B82F6" />

    <SolidColorBrush x:Key="UserMessageBackgroundBrush"
                 Color="#1E3A5F" />

    <SolidColorBrush x:Key="UserMessageLabelBrush"
                 Color="#93C5FD" />

    <SolidColorBrush x:Key="UserMessageTextBrush"
                 Color="#DBEAFE" />

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarItemHoverBrush"
                 Color="#1E293B" />

    <SolidColorBrush x:Key="SidebarItemSelectedBrush"
                 Color="#1D4ED8" />

    <!-- Dropdown -->
    <SolidColorBrush x:Key="DropdownBackgroundBrush"
                 Color="#1E293B" />

    <SolidColorBrush x:Key="DropdownBorderBrush"
                 Color="#475569" />

    <SolidColorBrush x:Key="DropdownItemHoverBrush"
                 Color="#334155" />

    <SolidColorBrush x:Key="DropdownItemSelectedBrush"
                 Color="#2563EB" />

    <SolidColorBrush x:Key="DropdownTextBrush"
                 Color="#F8FAFC" />

</ResourceDictionary>