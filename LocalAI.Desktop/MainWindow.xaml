<Window x:Class="LocalAI.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:selectors="clr-namespace:LocalAI.Desktop.Selectors"
        Title="LocalAI"
        Width="1000"
        Height="700"
        MinWidth="700"
        MinHeight="500">

    <Window.Resources>

        <!-- ============================= -->
        <!-- User Message -->
        <!-- ============================= -->

        <DataTemplate x:Key="UserMessageTemplate">

            <Grid Margin="0,8">

                <Grid HorizontalAlignment="Right">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>

                    <!-- User message bubble -->
                    <Border Grid.Column="0"
                            MaxWidth="650"
                            Padding="14,11"
                            CornerRadius="14"
                            Background="#E8F0FE">

                        <StackPanel>

                            <TextBlock Text="You"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#3559A8"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,0,5" />

                            <TextBlock Text="{Binding Content}"
                                       TextWrapping="Wrap"
                                       FontSize="15"
                                       LineHeight="22" />

                        </StackPanel>

                    </Border>

                    <!-- User icon -->
                    <Border Grid.Column="1"
                            Width="36"
                            Height="36"
                            CornerRadius="18"
                            Background="#DDE2E8"
                            Margin="8,0,0,0"
                            VerticalAlignment="Top">

                        <TextBlock Text="●"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#555555" />

                    </Border>

                </Grid>

            </Grid>

        </DataTemplate>


        <!-- ============================= -->
        <!-- LocalAI Message -->
        <!-- ============================= -->

        <DataTemplate x:Key="AssistantMessageTemplate">

            <Grid Margin="0,8">

                <Grid HorizontalAlignment="Left">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- LocalAI icon -->
                    <Border Grid.Column="0"
                            Width="36"
                            Height="36"
                            CornerRadius="18"
                            Background="#E8F0FE"
                            VerticalAlignment="Top">

                        <TextBlock Text="✦"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#356AE6" />

                    </Border>

                    <!-- LocalAI message bubble -->
                    <Border Grid.Column="1"
                            MaxWidth="650"
                            Padding="14,11"
                            CornerRadius="14"
                            Background="White"
                            BorderBrush="#E5E5E5"
                            BorderThickness="1">

                        <StackPanel>

                            <TextBlock Text="LocalAI"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#555555"
                                       Margin="0,0,0,5" />

                            <TextBlock Text="{Binding Content}"
                                       TextWrapping="Wrap"
                                       FontSize="15"
                                       LineHeight="22" />

                        </StackPanel>

                    </Border>

                </Grid>

            </Grid>

        </DataTemplate>


        <!-- ============================= -->
        <!-- Message Template Selector -->
        <!-- ============================= -->

        <selectors:ChatMessageTemplateSelector
            x:Key="ChatMessageTemplateSelector"
            UserTemplate="{StaticResource UserMessageTemplate}"
            AssistantTemplate="{StaticResource AssistantMessageTemplate}" />

    </Window.Resources>


    <!-- ============================= -->
    <!-- Main Layout -->
    <!-- ============================= -->

    <Grid Background="#F7F7F8">

        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <!-- ============================= -->
        <!-- Header -->
        <!-- ============================= -->

        <Border Grid.Row="0"
        Background="White"
        BorderBrush="#E5E5E5"
        BorderThickness="0,0,0,1">

            <Grid Margin="20,0">

                <TextBlock Text="LocalAI"
                   VerticalAlignment="Center"
                   FontSize="22"
                   FontWeight="SemiBold" />

                <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <Button x:Name="NewChatButton"
                    Content="＋ New Chat"
                    Click="NewChatButton_Click"
                    Margin="0,0,20,0"
                    Padding="14,7"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#2563EB"
                    Cursor="Hand"
                    FontSize="13"
                    FontWeight="SemiBold" />

                    <TextBlock Text="Offline AI"
                       VerticalAlignment="Center"
                       Foreground="#777777"
                       FontSize="13" />

                </StackPanel>

            </Grid>

        </Border>


        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <!-- ============================= -->
            <!-- Conversation Sidebar -->
            <!-- ============================= -->

            <Border Grid.Column="0"
            Background="White"
            BorderBrush="#E5E5E5"
            BorderThickness="0,0,1,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>


                    <!-- Sidebar Header -->

                    <TextBlock Grid.Row="0"
                       Text="Conversations"
                       Margin="18,18,18,12"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#333333" />


                    <!-- Conversation List -->

                    <ListBox x:Name="ConversationsListBox"
                     Grid.Row="1"
                     Margin="10,0,10,10"
                     BorderThickness="0"
                     Background="Transparent"
                     SelectionChanged="ConversationsListBox_SelectionChanged">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border Padding="12,10"
                                Margin="0,2"
                                CornerRadius="8">

                                    <TextBlock Text="{Binding Title}"
                                       FontSize="14"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="#333333" />

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>


            <!-- ============================= -->
            <!-- Chat Area -->
            <!-- ============================= -->

            <ScrollViewer x:Name="ChatScrollViewer"
                  Grid.Column="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

                <ItemsControl x:Name="MessagesItemsControl"
                      Margin="20"
                      ItemTemplateSelector="{StaticResource ChatMessageTemplateSelector}" />

            </ScrollViewer>

        </Grid>


        <!-- ============================= -->
        <!-- Message Input -->
        <!-- ============================= -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E5E5"
                BorderThickness="0,1,0,0"
                Padding="20,12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>


                <!-- Message textbox -->
                <TextBox x:Name="MessageTextBox"
                         Grid.Column="0"
                         MinHeight="46"
                         MaxHeight="140"
                         Padding="12"
                         FontSize="15"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         VerticalContentAlignment="Center"
                         KeyDown="MessageTextBox_KeyDown" />


                <!-- Send / Cancel -->
                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Send"
                        Width="100"
                        Height="46"
                        Margin="10,0,0,0"
                        FontSize="14"
                        Click="SendButton_Click" />

            </Grid>

        </Border>

    </Grid>

</Window>