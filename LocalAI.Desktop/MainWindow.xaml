<Window x:Class="LocalAI.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:selectors="clr-namespace:LocalAI.Desktop.Selectors"
        Icon="/LocalAI.Desktop;component/Assets/LocalAI.ico"
        Title="LocalAI"
        Background="#F7F8FA"
        Width="1200"
        Height="760"
        MinWidth="850"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ========================================================= -->
        <!-- Global -->
        <!-- ========================================================= -->

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="Segoe UI" />

            <Setter Property="Foreground"
                    Value="#1F2937" />
        </Style>


        <!-- ========================================================= -->
        <!-- Header Button -->
        <!-- ========================================================= -->

        <Style x:Key="HeaderButton"
               TargetType="Button">

            <Setter Property="FontFamily"
                    Value="Segoe UI" />

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Foreground"
                    Value="#2563EB" />

            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="Padding"
                    Value="12,7" />

            <Setter Property="Cursor"
                    Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#EFF6FF" />

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#DBEAFE" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- Conversation List -->
        <!-- ========================================================= -->

        <Style x:Key="ConversationItemStyle"
               TargetType="ListBoxItem">

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />

            <Setter Property="Padding"
                    Value="0" />

            <Setter Property="Margin"
                    Value="6,2" />

            <Setter Property="Background"
                    Value="Transparent" />

            <Setter Property="BorderThickness"
                    Value="0" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ListBoxItem">

                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="9"
                                Padding="12,10">

                            <ContentPresenter />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#F3F4F6" />

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#E8F0FE" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- ComboBox -->
        <!-- ========================================================= -->

        <Style x:Key="ModernComboBox"
               TargetType="ComboBox">

            <Setter Property="FontFamily"
                    Value="Segoe UI" />

            <Setter Property="FontSize"
                    Value="13" />

            <Setter Property="Foreground"
                    Value="#374151" />

            <Setter Property="Background"
                    Value="#F9FAFB" />

            <Setter Property="BorderBrush"
                    Value="#D1D5DB" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Setter Property="Padding"
                    Value="8,4" />

            <Setter Property="Cursor"
                    Value="Hand" />

        </Style>


        <!-- ========================================================= -->
        <!-- User Message -->
        <!-- ========================================================= -->

        <DataTemplate x:Key="UserMessageTemplate">

            <Grid Margin="0,8">

                <Border HorizontalAlignment="Right"
                MaxWidth="720"
                Padding="15,11"
                CornerRadius="16"
                Background="#E8F0FE">

                    <StackPanel>

                        <TextBlock Text="You"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#5272B8"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,4" />

                        <TextBlock Text="{Binding Content}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           LineHeight="21"
                           Foreground="#1E3A8A" />

                    </StackPanel>

                </Border>

            </Grid>

        </DataTemplate>


        <!-- ========================================================= -->
        <!-- Assistant Message -->
        <!-- ========================================================= -->

        <DataTemplate x:Key="AssistantMessageTemplate">

            <Grid Margin="0,8">

                <StackPanel HorizontalAlignment="Left"
                    MaxWidth="780">

                    <!-- LocalAI header -->

                    <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,5">

                        <Border Width="30"
                        Height="30"
                        CornerRadius="15"
                        Background="#E8F0FE">

                            <Image Source="/LocalAI.Desktop;component/Assets/LocalAI.png"
                           Width="18"
                           Height="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                        </Border>

                        <TextBlock Text="LocalAI"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#64748B"
                           VerticalAlignment="Center"
                           Margin="9,0,0,0" />

                    </StackPanel>


                    <!-- AI response -->

                    <Border Background="#FFFFFF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="15,12">

                        <TextBlock Text="{Binding Content}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           LineHeight="22"
                           Foreground="#1F2937" />

                    </Border>

                </StackPanel>

            </Grid>

        </DataTemplate>


        <!-- ========================================================= -->
        <!-- Message Selector -->
        <!-- ========================================================= -->

        <selectors:ChatMessageTemplateSelector
            x:Key="ChatMessageTemplateSelector"
            UserTemplate="{StaticResource UserMessageTemplate}"
            AssistantTemplate="{StaticResource AssistantMessageTemplate}" />

    </Window.Resources>


    <!-- ============================================================= -->
    <!-- Main Layout -->
    <!-- ============================================================= -->

    <Grid Background="#F7F8FA">

        <!-- ========================================================= -->
        <!-- Main Rows -->
        <!-- ========================================================= -->

        <Grid.RowDefinitions>

            <!-- Header -->
            <RowDefinition Height="68" />

            <!-- Chat -->
            <RowDefinition Height="*" />

            <!-- Input -->
            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>


        <!-- ========================================================= -->
        <!-- Main Columns -->
        <!-- ========================================================= -->

        <Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <ColumnDefinition Width="260" />

            <!-- Main Chat -->
            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>


        <!-- ========================================================= -->
        <!-- Header -->
        <!-- ========================================================= -->

        <Border Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="#FFFFFF"
            BorderBrush="#E8EAF0"
            BorderThickness="0,0,0,1">

            <Grid Margin="22,0">

                <!-- ================================================= -->
                <!-- Logo -->
                <!-- ================================================= -->

                <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                    <Image Source="/LocalAI.Desktop;component/Assets/LocalAI.png"
                       Width="32"
                       Height="32"
                       Margin="0,0,10,0" />

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="LocalAI"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#111827" />

                        <TextBlock Text="Offline AI"
                               FontSize="10"
                               Foreground="#94A3B8"
                               Margin="1,1,0,0" />

                    </StackPanel>

                </StackPanel>


                <!-- ================================================= -->
                <!-- Header Right Side -->
                <!-- ================================================= -->

                <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">


                    <!-- Model Label -->

                    <TextBlock Text="Model"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="#64748B"
                           FontSize="12" />


                    <!-- Model Selector -->

                    <ComboBox x:Name="ModelComboBox"
                          Width="190"
                          Height="34"
                          Margin="0,0,14,0"
                          DisplayMemberPath="Name"
                          SelectionChanged="ModelComboBox_SelectionChanged"
                          Style="{StaticResource ModernComboBox}" />


                    <!-- Model Status -->

                    <Border Background="#ECFDF5"
                        CornerRadius="8"
                        Padding="9,5"
                        Margin="0,0,12,0">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="7"
                                 Height="7"
                                 Fill="#16A34A"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0" />

                            <TextBlock x:Name="ModelStatusTextBlock"
                                   Text="Initializing..."
                                   VerticalAlignment="Center"
                                   Foreground="#15803D"
                                   FontSize="12"
                                   FontWeight="SemiBold" />

                        </StackPanel>

                    </Border>


                    <!-- New Chat -->

                    <Button x:Name="NewChatButton"
                        Content="＋ New Chat"
                        Click="NewChatButton_Click"
                        Margin="0,0,12,0"
                        Style="{StaticResource HeaderButton}" />


                    <!-- Offline -->

                    <Border Background="#F8FAFC"
                        CornerRadius="8"
                        Padding="9,5">

                        <TextBlock Text="Offline"
                               Foreground="#64748B"
                               FontSize="12"
                               VerticalAlignment="Center" />

                    </Border>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- Sidebar -->
        <!-- ========================================================= -->

        <Border Grid.Row="1"
            Grid.RowSpan="2"
            Grid.Column="0"
            Background="#FFFFFF"
            BorderBrush="#E8EAF0"
            BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="*" />

                </Grid.RowDefinitions>


                <!-- Sidebar Header -->

                <StackPanel Grid.Row="0"
                        Margin="18,20,18,12">

                    <TextBlock Text="Conversations"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#374151" />

                    <TextBlock Text="Your recent chats"
                           FontSize="11"
                           Foreground="#9CA3AF"
                           Margin="0,3,0,0" />

                </StackPanel>


                <!-- Conversation List -->

                <ListBox x:Name="ConversationsListBox"
                     Grid.Row="1"
                     Margin="8,0,8,12"
                     BorderThickness="0"
                     Background="Transparent"
                     SelectionChanged="ConversationsListBox_SelectionChanged"
                     ItemContainerStyle="{StaticResource ConversationItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <TextBlock Text="{Binding Title}"
                                   FontSize="13"
                                   Foreground="#374151"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- Chat Area -->
        <!-- ========================================================= -->

        <Grid Grid.Row="1"
          Grid.Column="1"
          Background="#F7F8FA">

            <ScrollViewer x:Name="ChatScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

                <ItemsControl x:Name="MessagesItemsControl"
                          Margin="30,24,30,30"
                          ItemTemplateSelector="{StaticResource ChatMessageTemplateSelector}" />

            </ScrollViewer>

        </Grid>


        <!-- ========================================================= -->
        <!-- Message Input -->
        <!-- ========================================================= -->

        <Border Grid.Row="2"
            Grid.Column="1"
            Background="#F7F8FA"
            Padding="20,10,20,18">

            <Border Background="#FFFFFF"
                BorderBrush="#DDE2E8"
                BorderThickness="1"
                CornerRadius="14"
                Padding="8,6">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>


                    <!-- ================================================= -->
                    <!-- Message Input -->
                    <!-- ================================================= -->

                    <TextBox x:Name="MessageTextBox"
                         Grid.Column="0"
                         MinHeight="42"
                         MaxHeight="120"
                         Padding="10,7"
                         FontSize="14"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         VerticalContentAlignment="Center"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="#1F2937"
                         KeyDown="MessageTextBox_KeyDown" />


                    <!-- ================================================= -->
                    <!-- Send Button -->
                    <!-- ================================================= -->

                    <Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="➤"
                        Width="42"
                        Height="36"
                        Margin="8,0,0,0"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="SendButton_Click">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                    CornerRadius="10">

                                    <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </Grid>

            </Border>

        </Border>

    </Grid>

</Window>

